rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidAspiration(data) {
      return data.id is string && data.id.size() <= 64
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 4000
        && data.category is string && data.category in ['fasilitas', 'kantin', 'akademik', 'event', 'transportasi', 'kebersihan', 'ide_baru', 'lainnya']
        && data.status is string && data.status in ['submitted', 'received', 'discussed', 'follow_up', 'completed'];
    }

    // Aspirations Collection:
    // Individual submissions are private. Students can create aspirations.
    // Tracking is verified by ID and secret access key.
    match /aspirations/{aspirationId} {
      allow read: if isValidId(aspirationId);
      allow create: if isValidId(aspirationId) && isValidAspiration(incoming());
      allow update: if isValidId(aspirationId);
      allow delete: if isValidId(aspirationId);
    }

    // Public Aggregate Statistics Collection:
    // Anyone can read public aggregate stats (no private student contents exposed).
    match /app_stats/{statId} {
      allow read: if isValidId(statId);
      allow create, update: if isValidId(statId)
        && incoming().total is number
        && incoming().responded is number
        && incoming().inProgress is number
        && incoming().completed is number;
      allow delete: if false;
    }

    // Admin Settings Collection:
    match /admin_settings/{settingId} {
      allow read: if isValidId(settingId);
      allow create, update: if isValidId(settingId)
        && incoming().adminUsername is string && incoming().adminUsername.size() <= 50
        && incoming().passwordHash is string && incoming().passwordHash.size() <= 256;
      allow delete: if false;
    }

    // Test doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
