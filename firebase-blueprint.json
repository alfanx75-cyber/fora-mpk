{
  "entities": {
    "Aspiration": {
      "title": "Aspiration",
      "description": "Private student aspiration ticket submitted to MPK",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Ticket ID e.g. 2026-0001"
        },
        "accessKeyHash": {
          "type": "string",
          "description": "Cryptographic SHA-256 hash of secret access key"
        },
        "title": {
          "type": "string",
          "description": "Title of aspiration"
        },
        "description": {
          "type": "string",
          "description": "Detailed text of aspiration"
        },
        "category": {
          "type": "string",
          "description": "Category key"
        },
        "grade": {
          "type": "string",
          "description": "Grade level X, XI, XII or none"
        },
        "className": {
          "type": "string",
          "description": "Class identifier or Rahasia"
        },
        "status": {
          "type": "string",
          "description": "Current status submitted, received, discussed, follow_up, completed"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["id", "accessKeyHash", "title", "description", "category", "status"]
    },
    "AppStats": {
      "title": "AppStats",
      "description": "Public aggregated statistics for real-time dashboard",
      "type": "object",
      "properties": {
        "total": {
          "type": "number",
          "description": "Total active incoming aspirations"
        },
        "responded": {
          "type": "number",
          "description": "Aspirations with verified official response"
        },
        "inProgress": {
          "type": "number",
          "description": "Aspirations discussed or in follow-up"
        },
        "completed": {
          "type": "number",
          "description": "Aspirations marked completed"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["total", "responded", "inProgress", "completed"]
    },
    "AdminCredential": {
      "title": "AdminCredential",
      "description": "Custom admin credentials for MPK officers",
      "type": "object",
      "properties": {
        "adminUsername": {
          "type": "string"
        },
        "passwordHash": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["adminUsername", "passwordHash"]
    }
  }
}
